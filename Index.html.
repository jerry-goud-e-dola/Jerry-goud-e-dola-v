<!DOCTYPE html>
<html lang="ht">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101a33">
  <meta name="description" content="Jerry Goud e Dola — aprann finans, kalkile goud ak dola, epi pratike gratis.">
  <title>Jerry Goud e Dola</title>
  <style>
    :root {
      --navy: #101a33;
      --gold: #e6b84c;
      --bg: #f4f6fb;
      --text: #17213a;
      --muted: #667085;
      --white: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    header {
      background: var(--navy);
      color: white;
      padding: 18px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
    }
    .brand { font-size: 19px; font-weight: 800; }
    .brand span { color: var(--gold); }
    select, input, button {
      font: inherit;
      border-radius: 10px;
      padding: 12px;
    }
    select, input {
      border: 1px solid #d8deea;
      background: white;
      color: var(--text);
      width: 100%;
    }
    header select { width: auto; }
    .hero {
      background: linear-gradient(135deg, #101a33, #243b69);
      color: white;
      padding: 55px 6% 65px;
      text-align: center;
    }
    .hero h1 {
      font-size: clamp(30px, 6vw, 48px);
      margin: 0 0 15px;
    }
    .hero h1 span { color: var(--gold); }
    .hero p {
      line-height: 1.7;
      max-width: 620px;
      margin: 0 auto 24px;
      color: #e1e7f4;
    }
    .button {
      border: 0;
      background: var(--gold);
      color: var(--navy);
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }
    main {
      width: min(1050px, 92%);
      margin: 30px auto;
    }
    .section-title { margin: 36px 0 16px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }
    .card {
      background: white;
      padding: 23px;
      border-radius: 18px;
      box-shadow: 0 5px 22px #1826480b;
    }
    .card h3 { margin-top: 0; }
    .card p { color: var(--muted); line-height: 1.6; }
    .converter {
      max-width: 600px;
      margin: auto;
    }
    .field { margin: 16px 0; }
    .field label {
      display: block;
      font-weight: bold;
      margin-bottom: 8px;
    }
    .result {
      background: #fff7df;
      border: 1px solid #f0d68d;
      padding: 20px;
      border-radius: 14px;
      margin-top: 18px;
    }
    .result strong {
      font-size: 27px;
      overflow-wrap: anywhere;
    }
    .note {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.6;
    }
    .demo-balance {
      font-size: 27px;
      color: #147d52;
      font-weight: bold;
    }
    footer {
      margin-top: 45px;
      padding: 28px 5%;
      text-align: center;
      background: var(--navy);
      color: #e1e7f4;
      line-height: 1.8;
    }
    a { color: inherit; }
  </style>
</head>
