    const languageSelect = document.getElementById('languageSelect');

    function setLanguage(language) {
      const t = translations[language] || translations.ht;
      document.documentElement.lang = language;

      Object.keys(t).forEach(key => {
        const element = document.getElementById(key);
        if (element && !['invalid', 'usd', 'htg'].includes(key)) {
          if (key === 'heroTitle') {
            element.innerHTML = t[key];
          } else {
            element.textContent = t[key];
          }
        }
      });

      const direction = document.getElementById('direction');
      direction.options[0].text = t.usd;
      direction.options[1].text = t.htg;
      calculate();
    }

    function calculate() {
      const rate = Number(document.getElementById('rate').value);
      const amount = Number(document.getElementById('amount').value);
      const direction = document.getElementById('direction').value;
      const output = document.getElementById('result');
      const label = document.getElementById('resultLabel');
      const language = languageSelect.value;
      const t = translations[language] || translations.ht;

      if (!Number.isFinite(rate) || !Number.isFinite(amount) ||
          rate <= 0 || amount < 0 ||
          document.getElementById('rate').value === '' ||
          document.getElementById('amount').value === '') {
        output.textContent = t.invalid;
        label.textContent = t.resultLabel;
        return;
      }

      const result = direction === 'usd' ? amount * rate : amount / rate;
      const currency = direction === 'usd' ? 'HTG' : 'USD';

      output.textContent = new Intl.NumberFormat(
        language === 'fr' ? 'fr-FR' : language === 'es' ? 'es-ES' : 'en-US',
        { maximumFractionDigits: 2, minimumFractionDigits: 2 }
      ).format(result) + ' ' + currency;

      label.textContent = t.resultLabel;
    }

    languageSelect.addEventListener('change', event => {
      setLanguage(event.target.value);
