    <a class="button" href="#converter" id="heroButton">Kòmanse gratis</a>
  </section>

  <main>
    <h2 class="section-title" id="toolsTitle">Zouti prensipal yo</h2>
    <div class="grid">
      <article class="card">
        <h3 id="converterCardTitle">💱 Konvètisè lajan</h3>
        <p id="converterCardText">Kalkile montan goud ak dola avèk to echanj ou antre a.</p>
